{
  "api_version": 1,
  "id": "flow",
  "name": "Google Flow",
  "version": "0.3.1",
  "profile_policy": "rotate_on_limit",
  "operations": {
    "inspect": {
      "description": "Open or inspect an existing Flow project in the selected Chrome profile. Return the project ID, current mode and visible controls. Settings remain in their current state.",
      "parameters": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "description": "Optional existing Flow project ID or canonical project URL."
          },
          "mode": {
            "enum": [
              "classic",
              "agent"
            ],
            "description": "Expected composer mode. Inspection reports the actual mode."
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ],
            "description": "Filter visible model controls to the relevant media kind."
          }
        }
      }
    },
    "create_project": {
      "description": "Create a new Flow project in this extension's owned Chrome window.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        }
      }
    },
    "configure": {
      "description": "Select Flow settings and return native selected-control readback. Inspect exposes current model/option names.",
      "parameters": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "classic",
              "agent"
            ]
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "model": {
            "type": "string"
          },
          "aspect": {
            "type": "string"
          },
          "duration": {
            "type": "integer"
          },
          "resolution": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "input_type": {
            "enum": [
              "ingredients",
              "frames"
            ]
          }
        }
      }
    },
    "generate_image": {
      "description": "Submit one image request through the selected classic or Agent composer. Resume the returned job to observe the same source request.",
      "parameters": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "classic",
              "agent"
            ]
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "model": {
            "type": "string"
          },
          "aspect": {
            "type": "string"
          },
          "duration": {
            "type": "integer"
          },
          "resolution": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "input_type": {
            "enum": [
              "ingredients",
              "frames"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "image",
                    "video",
                    "character",
                    "voice"
                  ]
                },
                "slot": {
                  "enum": [
                    "first",
                    "last"
                  ]
                },
                "definition": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "base": {
                      "type": "string"
                    },
                    "dialogue": {
                      "type": "string"
                    },
                    "performance": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "voice": {
                      "type": "string"
                    },
                    "voice_definition": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "base": {
                          "type": "string"
                        },
                        "dialogue": {
                          "type": "string"
                        },
                        "performance": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    "generate_video": {
      "description": "Submit one video request through the selected classic or Agent composer. Resume the returned job to observe the same source request.",
      "parameters": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "classic",
              "agent"
            ]
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "model": {
            "type": "string"
          },
          "aspect": {
            "type": "string"
          },
          "duration": {
            "type": "integer"
          },
          "resolution": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "input_type": {
            "enum": [
              "ingredients",
              "frames"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "image",
                    "video",
                    "character",
                    "voice"
                  ]
                },
                "slot": {
                  "enum": [
                    "first",
                    "last"
                  ]
                },
                "definition": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "base": {
                      "type": "string"
                    },
                    "dialogue": {
                      "type": "string"
                    },
                    "performance": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "voice": {
                      "type": "string"
                    },
                    "voice_definition": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "base": {
                          "type": "string"
                        },
                        "dialogue": {
                          "type": "string"
                        },
                        "performance": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    "upload": {
      "description": "Upload a local image/video through the native picker and retain its portable local file and hash.",
      "parameters": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "bind_reference": {
      "description": "Select an exact titled asset through the native picker and verify its ingredient/frame chip.",
      "parameters": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "character",
              "voice"
            ]
          },
          "slot": {
            "enum": [
              "first",
              "last"
            ]
          }
        }
      }
    },
    "create_voice": {
      "description": "Synthesize and save a custom voice from a native base voice, then return the exact saved audio and fields. Resume the same job after an uncertain preview/save.",
      "parameters": {
        "type": "object",
        "required": [
          "base",
          "name",
          "dialogue",
          "performance"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "dialogue": {
            "type": "string"
          },
          "performance": {
            "type": "string"
          }
        }
      }
    },
    "create_character": {
      "description": "Create a saved native character from a local image, set its name/personality and optional voice, and read back the saved native identity. Resume the same job after interrupted creation.",
      "parameters": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          }
        }
      }
    }
  }
}
